<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：一枚金环 + 内透光 + 播放三角。

  相比原来"一圈细线 + 一个小三角"的写法，这里补了三样东西让它立起来：
    · 环用线性渐变（左上亮 → 右下暗），读起来是金属而不是色块；
    · 环内一圈径向暖光，像镜头里的反光，三角因此不是贴上去的；
    · 三角单独用更亮的一档渐变，和环拉开明度，视觉焦点落在它身上。

  几何全部收在半径 36dp 的安全区内（自适应图标只保证中心 72dp 可见，
  外面 18dp 会被各种形状的遮罩裁掉），所以环取 r=32、三角最远点 r=16。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 环内透光：径向渐变从中心暖金衰减到全透明，填满环的内圆 -->
    <path android:pathData="M54,28.5 A25.5,25.5,0,1,1,53.99,28.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="26">
                <item android:offset="0.00" android:color="#42F5DFAE" />
                <item android:offset="0.62" android:color="#16F5DFAE" />
                <item android:offset="1.00" android:color="#00F5DFAE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 金环：外 r=32、内 r=25.5，厚 6.5dp；evenOdd 挖空内圆 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,22 A32,32,0,1,1,53.99,22 Z M54,28.5 A25.5,25.5,0,1,0,54.01,28.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="22"
                android:endX="80"
                android:endY="86">
                <item android:offset="0.00" android:color="#FFF7E6BC" />
                <item android:offset="0.42" android:color="#FFDBB877" />
                <item android:offset="1.00" android:color="#FFA87C33" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 播放三角：三个角都做了 3.5dp 圆角，避免尖角在小尺寸下发虚 -->
    <path android:pathData="M45.5,44.5 L45.5,63.5 Q45.5,67 48.59,65.36 L66.91,55.64 Q70,54 66.91,52.36 L48.59,42.64 Q45.5,41 45.5,44.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="45.5"
                android:startY="41"
                android:endX="70"
                android:endY="67">
                <item android:offset="0.00" android:color="#FFFFF8E8" />
                <item android:offset="0.50" android:color="#FFF4DEAC" />
                <item android:offset="1.00" android:color="#FFD2A95E" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
