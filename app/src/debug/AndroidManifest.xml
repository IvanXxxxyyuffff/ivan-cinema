<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建生效。

  播放页是 exported="false" 的独立 Activity，adb shell 起不来它，
  于是播放页的截图只能靠 instrumentation 里 ActivityScenario 拉起 —— 但那样
  抓不到 Compose Dialog（选集面板是独立 window，captureToImage 只画当前 root），
  也抓不到系统栏。debug 下放开 exported，就能用 `adb shell am start` 直接拉起、
  用真实 screencap 拍下用户实际看到的一切（含对话框）。

  release 构建不含这个文件，导出面不变。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".player.PlayerActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>

</manifest>
